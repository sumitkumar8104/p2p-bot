# ──────────────────────────────────────────────
#  Binance P2P Chat — Environment Variables
# ──────────────────────────────────────────────

# Your Binance API Key (must have C2C / P2P permissions enabled)
BINANCE_API_KEY=your_api_key_here

# Your Binance API Secret (used to generate HMAC-SHA256 signatures)
BINANCE_API_SECRET=your_api_secret_here

# Server port (optional, defaults to 3000)
PORT=3000

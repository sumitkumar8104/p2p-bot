# ──────────────────────────────────────────────
#  Binance P2P Chat — Environment Variables
# ──────────────────────────────────────────────

# Your Binance API Key (must have C2C / P2P permissions enabled)
BINANCE_API_KEY=your_api_key_here

# Your Binance API Secret (used to generate HMAC-SHA256 signatures)
BINANCE_API_SECRET=your_api_secret_here

# Server port (optional, defaults to 3000)
PORT=3000

# ──────────────────────────────────────────────
#  Surepass PAN Verification API
# ──────────────────────────────────────────────
SUREPASS_API_KEY=your_surepass_api_key_here
SUREPASS_BASE_URL=https://kyc-api.surepass.io/api/v1

# ──────────────────────────────────────────────
#  Paytm Payment Gateway
# ──────────────────────────────────────────────
PAYTM_MERCHANT_ID=your_paytm_merchant_id
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
PAYTM_BASE_URL=https://securegw.paytm.in
PAYTM_WALLET_GUID=your_wallet_guid

# ──────────────────────────────────────────────
#  Encryption Key (32-byte hex for AES-256-GCM)
# ──────────────────────────────────────────────
ENCRYPTION_KEY=generate_a_64_char_hex_string_here

# ──────────────────────────────────────────────
#  Bot Configuration
# ──────────────────────────────────────────────
MAX_PAN_ATTEMPTS=3
ORDER_EXPIRY_MINUTES=30
